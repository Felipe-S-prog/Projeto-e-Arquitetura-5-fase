{
  "name": "sgp-server",
  "version": "0.1.0",
  "private": true,
  "description": "API do SGP (Sistema de Geração de Provas): Node.js + Express + MySQL em camadas.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:reset": "node src/database/migrate.js --reset",
    "db:seed": "node src/database/seed.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
