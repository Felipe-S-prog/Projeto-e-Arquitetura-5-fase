# Copie este arquivo para ".env" e ajuste se necessário.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

# API
PORT=3333
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sgp
DB_PASSWORD=sgp_dev
DB_NAME=sgp

# Para banco hospedado que exige SSL, configure conforme o provedor:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
# DB_SSL_CA_PATH=./ca.pem
# DB_SSL=true

# Autenticação
# Em produção, use um segredo aleatório exclusivo com pelo menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
