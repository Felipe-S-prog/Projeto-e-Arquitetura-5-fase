# Copie este arquivo para ".env" (cp .env.example .env) e ajuste se precisar.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# API
PORT=3333
# Endereço(s) do front-end autorizados a chamar a API (CORS). Separe vários com vírgula.
CLIENT_ORIGIN=http://localhost:5173

# MySQL (estes valores já batem com o docker-compose.yml desta pasta)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sgp
DB_PASSWORD=sgp_dev
DB_NAME=sgp
# Só para banco hospedado que exige SSL (por exemplo, Aiven). No MySQL local, deixe tudo comentado.
# Cole o certificado CA do serviço em uma linha (troque as quebras de linha por \n) ou use o caminho do arquivo:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
# DB_SSL_CA_PATH=./ca.pem
# DB_SSL=true   (liga o SSL sem certificado próprio)


# Autenticação (T07)
# Em produção, use um segredo aleatório exclusivo com pelo menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Primeiro administrador: habilitado em desenvolvimento; desabilite após a configuração inicial em produção.
ALLOW_ADMIN_BOOTSTRAP=true
# Domínios permitidos por papel (separe mais de um com vírgula, sem @).
ADMIN_EMAIL_DOMAINS=catolicasc.org.br
PROFESSOR_EMAIL_DOMAINS=catolicasc.org.br,catolicasc.edu.br
